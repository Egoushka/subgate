<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tarball has no git history for MinVer to read. -->
    <ProjectReference Include="$(PaceProjectPath)" AdditionalProperties="MinVerSkip=true" />
    <ProjectReference Include="..\Subgate.Providers.Anthropic\Subgate.Providers.Anthropic.csproj" />
  </ItemGroup>

</Project>
